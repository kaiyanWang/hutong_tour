/* pages/route-detail/route-detail.wxss */
.container {
  padding: 20rpx;
  padding-bottom: 40rpx;
  background-color: #f5f5f5;
  min-height: 100vh;
  box-sizing: border-box;
}

/* 加载状态 */
.loading {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 200rpx 40rpx;
}

.loading-spinner {
  width: 60rpx;
  height: 60rpx;
  border: 4rpx solid #e0e0e0;
  border-top-color: #8B4513;
  border-radius: 50%;
  animation: spin 1s linear infinite;
  margin-bottom: 20rpx;
}

@keyframes spin {
  to { transform: rotate(360deg); }
}

/* 卡片通用样式 */
.card {
  background-color: #ffffff;
  border-radius: 16rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.08);
  overflow: hidden;
}

/* 路线信息 */
.route-info {
  padding: 30rpx;
  margin-bottom: 20rpx;
}

.route-name {
  font-size: 40rpx;
  font-weight: bold;
  color: #333333;
  display: block;
  margin-bottom: 20rpx;
}

.route-meta {
  display: flex;
  margin-bottom: 20rpx;
}

.meta-item {
  display: flex;
  align-items: center;
  margin-right: 40rpx;
  padding: 8rpx 16rpx;
  background-color: #f5f5f5;
  border-radius: 20rpx;
}

.meta-icon {
  font-size: 28rpx;
  margin-right: 8rpx;
}

.meta-text {
  font-size: 26rpx;
  color: #666666;
}

.route-desc {
  font-size: 28rpx;
  color: #666666;
  line-height: 1.8;
  text-align: justify;
}

/* 地图区域 */
.map-section {
  padding: 30rpx;
  margin-bottom: 20rpx;
}

.section-header {
  display: flex;
  align-items: center;
  margin-bottom: 16rpx;
}

.section-icon {
  font-size: 32rpx;
  margin-right: 10rpx;
}

.section-title {
  flex: 1;
  font-size: 32rpx;
  font-weight: bold;
  color: #333333;
}

.section-count {
  font-size: 26rpx;
  color: #999999;
}

.map-tips {
  margin-bottom: 16rpx;
}

.map-tips .tips-text {
  font-size: 24rpx;
  color: #999999;
}

.map {
  width: 100%;
  height: 450rpx;
  border-radius: 12rpx;
}

/* POI列表 */
.poi-section {
  padding: 30rpx;
  margin-bottom: 20rpx;
}

.poi-list {
  margin-top: 10rpx;
}

.poi-item {
  display: flex;
  align-items: flex-start;
  padding: 20rpx 0;
}

.poi-order-wrapper {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-right: 20rpx;
}

.poi-order {
  width: 48rpx;
  height: 48rpx;
  line-height: 48rpx;
  text-align: center;
  background-color: #8B4513;
  color: #ffffff;
  border-radius: 50%;
  font-size: 26rpx;
  font-weight: bold;
  flex-shrink: 0;
}

.poi-line {
  width: 4rpx;
  flex: 1;
  min-height: 80rpx;
  background: linear-gradient(to bottom, #8B4513, #D2B48C);
  margin-top: 10rpx;
}

.poi-image {
  width: 140rpx;
  height: 140rpx;
  border-radius: 12rpx;
  flex-shrink: 0;
  margin-right: 20rpx;
}

.poi-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  min-height: 140rpx;
  justify-content: center;
}

.poi-name {
  font-size: 30rpx;
  font-weight: bold;
  color: #333333;
  margin-bottom: 8rpx;
}

.poi-category {
  display: inline-block;
  margin-bottom: 8rpx;
  align-self: flex-start;
}

.poi-brief {
  font-size: 26rpx;
  color: #999999;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
}

.poi-arrow {
  font-size: 36rpx;
  color: #cccccc;
  flex-shrink: 0;
  align-self: center;
}

/* 游览提示 */
.tips-section {
  padding: 24rpx 30rpx;
  background: linear-gradient(135deg, #FFF8E1, #FFECB3);
  border-radius: 16rpx;
}

.tips-header {
  display: flex;
  align-items: center;
  margin-bottom: 16rpx;
}

.tips-icon {
  font-size: 32rpx;
  margin-right: 10rpx;
}

.tips-title {
  font-size: 30rpx;
  font-weight: bold;
  color: #8B4513;
}

.tips-content {
  display: flex;
  flex-direction: column;
}

.tips-item {
  font-size: 26rpx;
  color: #666666;
  line-height: 2;
}

/* 空状态 */
.empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 200rpx 40rpx;
}

.empty-icon {
  font-size: 100rpx;
  margin-bottom: 30rpx;
}

.empty-text {
  color: #999999;
  font-size: 30rpx;
  margin-bottom: 30rpx;
}

.empty-btn {
  padding: 16rpx 48rpx;
  background-color: #8B4513;
  border-radius: 40rpx;
}

.empty-btn text {
  color: #ffffff;
  font-size: 28rpx;
}
