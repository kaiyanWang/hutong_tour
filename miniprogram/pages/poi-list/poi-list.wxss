/* pages/poi-list/poi-list.wxss */
.container {
  padding: 20rpx;
  padding-bottom: 40rpx;
  background-color: #f5f5f5;
  min-height: 100vh;
  box-sizing: border-box;
}

/* 搜索栏 */
.search-bar {
  display: flex;
  align-items: center;
  margin-bottom: 20rpx;
}

.search-input-wrapper {
  flex: 1;
  position: relative;
  display: flex;
  align-items: center;
  background-color: #ffffff;
  border-radius: 36rpx;
  padding-left: 20rpx;
}

.search-icon {
  font-size: 28rpx;
  margin-right: 10rpx;
}

.search-input {
  flex: 1;
  height: 72rpx;
  padding: 0 60rpx 0 10rpx;
  font-size: 28rpx;
}

.search-clear {
  position: absolute;
  right: 20rpx;
  width: 40rpx;
  height: 40rpx;
  line-height: 40rpx;
  text-align: center;
  color: #999999;
  font-size: 32rpx;
}

.search-btn {
  margin-left: 16rpx;
  padding: 0 30rpx;
  height: 72rpx;
  line-height: 72rpx;
  background-color: #8B4513;
  color: #ffffff;
  border-radius: 36rpx;
  font-size: 28rpx;
}

/* 分类筛选 */
.category-scroll {
  display: flex;
  white-space: nowrap;
  margin-bottom: 20rpx;
  padding: 10rpx 0;
}

.category-item {
  display: inline-block;
  padding: 12rpx 28rpx;
  margin-right: 16rpx;
  background-color: #ffffff;
  border-radius: 30rpx;
  font-size: 26rpx;
  color: #666666;
}

.category-item.active {
  background-color: #8B4513;
  color: #ffffff;
}

/* 加载状态 */
.loading {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 100rpx 40rpx;
}

.loading-spinner {
  width: 60rpx;
  height: 60rpx;
  border: 4rpx solid #e0e0e0;
  border-top-color: #8B4513;
  border-radius: 50%;
  animation: spin 1s linear infinite;
  margin-bottom: 20rpx;
}

@keyframes spin {
  to { transform: rotate(360deg); }
}

/* POI列表 */
.poi-list {
  display: flex;
  flex-direction: column;
}

.poi-card {
  display: flex;
  margin-bottom: 20rpx;
  overflow: hidden;
  background-color: #ffffff;
  border-radius: 16rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.08);
}

.poi-image {
  width: 220rpx;
  height: 220rpx;
  flex-shrink: 0;
}

.poi-info {
  flex: 1;
  padding: 20rpx;
  display: flex;
  flex-direction: column;
}

.poi-header {
  display: flex;
  align-items: center;
  margin-bottom: 10rpx;
}

.poi-name {
  font-size: 32rpx;
  font-weight: bold;
  color: #333333;
}

.poi-tag-row {
  margin-bottom: 10rpx;
}

.poi-brief {
  font-size: 26rpx;
  color: #666666;
  line-height: 1.6;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
  flex: 1;
}

.poi-address {
  display: flex;
  align-items: center;
  margin-top: 10rpx;
}

.address-icon {
  font-size: 24rpx;
  margin-right: 6rpx;
}

.address-text {
  font-size: 24rpx;
  color: #999999;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

/* 空状态 */
.empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 150rpx 40rpx;
}

.empty-icon {
  font-size: 100rpx;
  margin-bottom: 30rpx;
}

.empty-text {
  color: #999999;
  font-size: 30rpx;
  margin-bottom: 30rpx;
}

.empty-btn {
  padding: 16rpx 48rpx;
  background-color: #8B4513;
  border-radius: 40rpx;
}

.empty-btn text {
  color: #ffffff;
  font-size: 28rpx;
}
