<!--pages/poi-list/poi-list.wxml-->
<view class="container">
  <!-- 搜索栏 -->
  <view class="search-bar">
    <view class="search-input-wrapper">
      <text class="search-icon">🔍</text>
      <input 
        class="search-input" 
        placeholder="搜索景点名称" 
        value="{{searchKeyword}}"
        bindinput="onSearchInput"
        bindconfirm="onSearch"
      />
      <view class="search-clear" wx:if="{{searchKeyword}}" bindtap="onClearSearch">×</view>
    </view>
    <view class="search-btn" bindtap="onSearch">搜索</view>
  </view>

  <!-- 分类筛选 -->
  <scroll-view class="category-scroll" scroll-x enable-flex>
    <view 
      class="category-item {{selectedCategory === item.key ? 'active' : ''}}"
      wx:for="{{categories}}"
      wx:key="key"
      bindtap="onCategorySelect"
      data-category="{{item.key}}"
    >
      {{item.name}}
    </view>
  </scroll-view>

  <!-- 加载状态 -->
  <view class="loading" wx:if="{{loading}}">
    <view class="loading-spinner"></view>
    <text class="loading-text">加载中...</text>
  </view>

  <!-- POI列表 -->
  <view class="poi-list" wx:if="{{!loading && filteredPois.length > 0}}">
    <view 
      class="poi-card card" 
      wx:for="{{filteredPois}}" 
      wx:key="id"
      bindtap="navigateToDetail"
      data-id="{{item.id}}"
    >
      <image class="poi-image" src="{{item.images[0] || '/images/placeholder.png'}}" mode="aspectFill"></image>
      <view class="poi-info">
        <view class="poi-header">
          <text class="poi-name">{{item.name}}</text>
        </view>
        <view class="poi-tag-row">
          <text class="tag tag-{{item.category}}">{{item.category_display}}</text>
        </view>
        <text class="poi-brief">{{item.brief}}</text>
        <view class="poi-address">
          <text class="address-icon">📍</text>
          <text class="address-text">{{item.address}}</text>
        </view>
      </view>
    </view>
  </view>

  <!-- 空状态 -->
  <view class="empty" wx:if="{{!loading && filteredPois.length === 0}}">
    <text class="empty-icon">🔍</text>
    <text class="empty-text">{{searchKeyword ? '未找到相关景点' : '暂无景点数据'}}</text>
    <view class="empty-btn" wx:if="{{searchKeyword}}" bindtap="onClearSearch">
      <text>清除搜索</text>
    </view>
  </view>
</view>
