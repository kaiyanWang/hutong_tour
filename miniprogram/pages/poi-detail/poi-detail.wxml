<!--pages/poi-detail/poi-detail.wxml-->
<view class="container">
  <!-- 加载状态 -->
  <view class="loading" wx:if="{{loading}}">
    <view class="loading-spinner"></view>
    <text class="loading-text">加载中...</text>
  </view>

  <!-- POI详情 -->
  <view wx:if="{{!loading && poi}}">
    <!-- 图片轮播 -->
    <view class="image-section">
      <swiper 
        class="image-swiper" 
        indicator-dots="{{poi.images.length > 1}}"
        indicator-color="rgba(255,255,255,0.5)"
        indicator-active-color="#ffffff"
        autoplay
        circular
        bindchange="onSwiperChange"
      >
        <swiper-item wx:for="{{poi.images}}" wx:key="*this">
          <image 
            class="poi-image" 
            src="{{item}}" 
            mode="aspectFill"
            bindtap="previewImage"
            data-src="{{item}}"
          ></image>
        </swiper-item>
      </swiper>
      <view class="image-counter" wx:if="{{poi.images.length > 1}}">
        {{currentImageIndex + 1}}/{{poi.images.length}}
      </view>
    </view>

    <!-- 基本信息 -->
    <view class="info-section card">
      <view class="info-header">
        <view class="poi-title-row">
          <text class="poi-name">{{poi.name}}</text>
          <text class="tag tag-{{poi.category}}">{{poi.category_display}}</text>
        </view>
        <view class="favorite-btn {{isFavorite ? 'favorited' : ''}}" bindtap="toggleFavorite">
          <text class="favorite-icon">{{isFavorite ? '❤️' : '🤍'}}</text>
          <text class="favorite-text">{{isFavorite ? '已收藏' : '收藏'}}</text>
        </view>
      </view>
      <view class="address-row" bindtap="openNavigation">
        <text class="address-icon">📍</text>
        <text class="address-text">{{poi.address}}</text>
        <text class="nav-arrow">›</text>
      </view>
    </view>

    <!-- 详细描述 -->
    <view class="desc-section card">
      <view class="section-header">
        <text class="section-icon">📝</text>
        <text class="section-title">详细介绍</text>
      </view>
      <text class="desc-text">{{poi.description}}</text>
    </view>

    <!-- 地图 -->
    <view class="map-section card">
      <view class="section-header">
        <text class="section-icon">🗺️</text>
        <text class="section-title">位置</text>
        <view class="nav-btn" bindtap="openNavigation">
          <text class="nav-btn-text">导航</text>
        </view>
      </view>
      <map 
        id="poiMap"
        class="map"
        longitude="{{poi.longitude}}"
        latitude="{{poi.latitude}}"
        scale="17"
        markers="{{markers}}"
        show-location="{{true}}"
        enable-scroll="{{true}}"
        enable-zoom="{{true}}"
      ></map>
    </view>
  </view>

  <!-- 空状态 -->
  <view class="empty" wx:if="{{!loading && !poi}}">
    <text class="empty-icon">😕</text>
    <text class="empty-text">景点不存在</text>
    <view class="empty-btn" bindtap="navigateBack">
      <text>返回列表</text>
    </view>
  </view>
</view>
