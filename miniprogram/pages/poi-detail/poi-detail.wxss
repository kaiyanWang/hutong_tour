/* pages/poi-detail/poi-detail.wxss */
.container {
  padding-bottom: 40rpx;
  background-color: #f5f5f5;
  min-height: 100vh;
}

/* 加载状态 */
.loading {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 200rpx 40rpx;
}

.loading-spinner {
  width: 60rpx;
  height: 60rpx;
  border: 4rpx solid #e0e0e0;
  border-top-color: #8B4513;
  border-radius: 50%;
  animation: spin 1s linear infinite;
  margin-bottom: 20rpx;
}

@keyframes spin {
  to { transform: rotate(360deg); }
}

/* 图片区域 */
.image-section {
  position: relative;
}

.image-swiper {
  width: 100%;
  height: 500rpx;
}

.poi-image {
  width: 100%;
  height: 100%;
}

.image-counter {
  position: absolute;
  right: 20rpx;
  bottom: 20rpx;
  padding: 8rpx 20rpx;
  background-color: rgba(0, 0, 0, 0.5);
  color: #ffffff;
  font-size: 24rpx;
  border-radius: 20rpx;
}

/* 卡片通用样式 */
.card {
  margin: 20rpx;
  background-color: #ffffff;
  border-radius: 16rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.08);
  overflow: hidden;
}

/* 信息区域 */
.info-section {
  padding: 30rpx;
}

.info-header {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  margin-bottom: 20rpx;
}

.poi-title-row {
  display: flex;
  flex-direction: column;
  flex: 1;
}

.poi-name {
  font-size: 40rpx;
  font-weight: bold;
  color: #333333;
  margin-bottom: 12rpx;
}

.favorite-btn {
  display: flex;
  align-items: center;
  padding: 12rpx 24rpx;
  background-color: #f5f5f5;
  border-radius: 30rpx;
  flex-shrink: 0;
  margin-left: 20rpx;
}

.favorite-btn.favorited {
  background-color: #FFF5F5;
}

.favorite-icon {
  font-size: 32rpx;
  margin-right: 8rpx;
}

.favorite-text {
  font-size: 26rpx;
  color: #666666;
}

.favorite-btn.favorited .favorite-text {
  color: #E53935;
}

.address-row {
  display: flex;
  align-items: center;
  padding: 20rpx;
  background-color: #fafafa;
  border-radius: 12rpx;
}

.address-icon {
  font-size: 28rpx;
  margin-right: 8rpx;
}

.address-text {
  flex: 1;
  font-size: 28rpx;
  color: #666666;
}

.nav-arrow {
  font-size: 32rpx;
  color: #999999;
}

/* 描述区域 */
.desc-section {
  padding: 30rpx;
}

.section-header {
  display: flex;
  align-items: center;
  margin-bottom: 20rpx;
}

.section-icon {
  font-size: 32rpx;
  margin-right: 10rpx;
}

.section-title {
  flex: 1;
  font-size: 32rpx;
  font-weight: bold;
  color: #333333;
}

.desc-text {
  font-size: 28rpx;
  color: #666666;
  line-height: 1.8;
  text-align: justify;
}

/* 地图区域 */
.map-section {
  padding: 30rpx;
}

.nav-btn {
  padding: 10rpx 24rpx;
  background-color: #8B4513;
  border-radius: 30rpx;
}

.nav-btn-text {
  color: #ffffff;
  font-size: 24rpx;
}

.map {
  width: 100%;
  height: 400rpx;
  border-radius: 12rpx;
  margin-top: 10rpx;
}

/* 空状态 */
.empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 200rpx 40rpx;
}

.empty-icon {
  font-size: 100rpx;
  margin-bottom: 30rpx;
}

.empty-text {
  color: #999999;
  font-size: 30rpx;
  margin-bottom: 30rpx;
}

.empty-btn {
  padding: 16rpx 48rpx;
  background-color: #8B4513;
  border-radius: 40rpx;
}

.empty-btn text {
  color: #ffffff;
  font-size: 28rpx;
}
