/* pages/index/index.wxss */
.container {
  padding-bottom: 40rpx;
  background-color: #f5f5f5;
}

/* 加载状态 */
.loading {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 200rpx 40rpx;
}

.loading-spinner {
  width: 60rpx;
  height: 60rpx;
  border: 4rpx solid #e0e0e0;
  border-top-color: #8B4513;
  border-radius: 50%;
  animation: spin 1s linear infinite;
  margin-bottom: 20rpx;
}

@keyframes spin {
  to { transform: rotate(360deg); }
}

/* 头图区域 */
.hero-section {
  position: relative;
  width: 100%;
  height: 450rpx;
}

.hero-image {
  width: 100%;
  height: 100%;
}

.hero-overlay {
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  padding: 60rpx 30rpx 40rpx;
  background: linear-gradient(transparent, rgba(0, 0, 0, 0.8));
}

.hero-title {
  display: block;
  color: #ffffff;
  font-size: 52rpx;
  font-weight: bold;
  margin-bottom: 10rpx;
}

.hero-subtitle {
  display: block;
  color: rgba(255, 255, 255, 0.8);
  font-size: 28rpx;
}

/* 卡片样式 */
.card {
  margin: 20rpx;
  background-color: #ffffff;
  border-radius: 16rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.08);
  overflow: hidden;
}

.card-header {
  display: flex;
  align-items: center;
  padding: 24rpx 30rpx;
  border-bottom: 1rpx solid #f0f0f0;
}

.card-icon {
  font-size: 36rpx;
  margin-right: 12rpx;
}

.card-title {
  flex: 1;
  font-size: 32rpx;
  font-weight: bold;
  color: #333333;
}

.card-body {
  padding: 24rpx 30rpx;
}

/* 导航按钮 */
.nav-btn {
  padding: 10rpx 24rpx;
  background-color: #8B4513;
  border-radius: 30rpx;
}

.nav-btn-text {
  color: #ffffff;
  font-size: 24rpx;
}

/* 简介文本 */
.intro-text,
.history-text {
  font-size: 28rpx;
  color: #666666;
  line-height: 1.8;
  text-align: justify;
}

/* 地图 */
.map-body {
  padding: 0;
}

.map {
  width: 100%;
  height: 400rpx;
}

.map-info {
  padding: 20rpx 30rpx;
  background-color: #fafafa;
}

.map-address {
  font-size: 26rpx;
  color: #666666;
}

/* 快捷入口 */
.quick-entry {
  display: flex;
  justify-content: space-around;
  padding: 40rpx 20rpx;
  margin: 20rpx;
  background-color: #ffffff;
  border-radius: 16rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.08);
}

.entry-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 20rpx 30rpx;
  flex: 1;
}

.entry-icon-wrapper {
  width: 100rpx;
  height: 100rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 16rpx;
}

.poi-bg {
  background: linear-gradient(135deg, #FFE0B2, #FFCC80);
}

.route-bg {
  background: linear-gradient(135deg, #B3E5FC, #81D4FA);
}

.entry-icon {
  font-size: 48rpx;
}

.entry-text {
  font-size: 30rpx;
  color: #333333;
  font-weight: 500;
  margin-bottom: 6rpx;
}

.entry-desc {
  font-size: 22rpx;
  color: #999999;
}

/* 温馨提示 */
.tips-card {
  margin: 20rpx;
  padding: 24rpx 30rpx;
  background: linear-gradient(135deg, #FFF8E1, #FFECB3);
  border-radius: 16rpx;
}

.tips-header {
  display: flex;
  align-items: center;
  margin-bottom: 16rpx;
}

.tips-icon {
  font-size: 32rpx;
  margin-right: 10rpx;
}

.tips-title {
  font-size: 30rpx;
  font-weight: bold;
  color: #8B4513;
}

.tips-content {
  display: flex;
  flex-direction: column;
}

.tips-text {
  font-size: 26rpx;
  color: #666666;
  line-height: 2;
}

/* 空状态 */
.empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 200rpx 40rpx;
}

.empty-icon {
  font-size: 100rpx;
  margin-bottom: 30rpx;
}

.empty-text {
  color: #999999;
  font-size: 30rpx;
  margin-bottom: 30rpx;
}

.empty-btn {
  padding: 16rpx 48rpx;
  background-color: #8B4513;
  border-radius: 40rpx;
}

.empty-btn text {
  color: #ffffff;
  font-size: 28rpx;
}
