<!--pages/route-list/route-list.wxml-->
<view class="container">
  <!-- 页面标题 -->
  <view class="page-header">
    <text class="page-title">🗺️ 推荐路线</text>
    <text class="page-subtitle">精选游览路线，带你探索胡同之美</text>
  </view>

  <!-- 加载状态 -->
  <view class="loading" wx:if="{{loading}}">
    <view class="loading-spinner"></view>
    <text class="loading-text">加载中...</text>
  </view>

  <!-- 路线列表 -->
  <view class="route-list" wx:if="{{!loading && routes.length > 0}}">
    <view 
      class="route-card card" 
      wx:for="{{routes}}" 
      wx:key="id"
      bindtap="navigateToDetail"
      data-id="{{item.id}}"
    >
      <view class="route-header">
        <view class="route-title-row">
          <text class="route-name">{{item.name}}</text>
        </view>
        <view class="route-badges">
          <view class="route-badge poi-badge">
            <text class="badge-icon">📍</text>
            <text class="badge-text">{{item.poi_count}}个景点</text>
          </view>
          <view class="route-badge time-badge">
            <text class="badge-icon">⏱️</text>
            <text class="badge-text">{{item.duration}}分钟</text>
          </view>
        </view>
      </view>
      <text class="route-desc">{{item.description}}</text>
      <view class="route-footer">
        <view class="route-action">
          <text class="action-text">查看详情</text>
          <text class="action-arrow">›</text>
        </view>
      </view>
    </view>
  </view>

  <!-- 空状态 -->
  <view class="empty" wx:if="{{!loading && routes.length === 0}}">
    <text class="empty-icon">🗺️</text>
    <text class="empty-text">暂无推荐路线</text>
    <view class="empty-btn" bindtap="loadRouteList">
      <text>点击重试</text>
    </view>
  </view>
</view>
