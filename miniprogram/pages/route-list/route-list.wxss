/* pages/route-list/route-list.wxss */
.container {
  padding: 20rpx;
  padding-bottom: 40rpx;
  background-color: #f5f5f5;
  min-height: 100vh;
  box-sizing: border-box;
}

/* 页面标题 */
.page-header {
  padding: 30rpx 20rpx;
  margin-bottom: 10rpx;
}

.page-title {
  display: block;
  font-size: 40rpx;
  font-weight: bold;
  color: #333333;
  margin-bottom: 10rpx;
}

.page-subtitle {
  display: block;
  font-size: 26rpx;
  color: #999999;
}

/* 加载状态 */
.loading {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 100rpx 40rpx;
}

.loading-spinner {
  width: 60rpx;
  height: 60rpx;
  border: 4rpx solid #e0e0e0;
  border-top-color: #8B4513;
  border-radius: 50%;
  animation: spin 1s linear infinite;
  margin-bottom: 20rpx;
}

@keyframes spin {
  to { transform: rotate(360deg); }
}

/* 路线列表 */
.route-list {
  display: flex;
  flex-direction: column;
}

.route-card {
  padding: 30rpx;
  margin-bottom: 20rpx;
  background-color: #ffffff;
  border-radius: 16rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.08);
}

.route-header {
  margin-bottom: 20rpx;
}

.route-title-row {
  margin-bottom: 16rpx;
}

.route-name {
  font-size: 36rpx;
  font-weight: bold;
  color: #333333;
}

.route-badges {
  display: flex;
  flex-wrap: wrap;
}

.route-badge {
  display: flex;
  align-items: center;
  padding: 8rpx 16rpx;
  border-radius: 20rpx;
  margin-right: 16rpx;
  margin-bottom: 8rpx;
}

.poi-badge {
  background-color: #FFF3E0;
}

.poi-badge .badge-text {
  color: #E65100;
}

.time-badge {
  background-color: #E3F2FD;
}

.time-badge .badge-text {
  color: #1565C0;
}

.badge-icon {
  font-size: 24rpx;
  margin-right: 6rpx;
}

.badge-text {
  font-size: 24rpx;
}

.route-desc {
  font-size: 28rpx;
  color: #666666;
  line-height: 1.6;
  margin-bottom: 20rpx;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
}

.route-footer {
  display: flex;
  justify-content: flex-end;
  padding-top: 20rpx;
  border-top: 1rpx solid #f0f0f0;
}

.route-action {
  display: flex;
  align-items: center;
  padding: 12rpx 24rpx;
  background-color: #8B4513;
  border-radius: 30rpx;
}

.action-text {
  color: #ffffff;
  font-size: 26rpx;
}

.action-arrow {
  color: #ffffff;
  font-size: 28rpx;
  margin-left: 6rpx;
}

/* 空状态 */
.empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 150rpx 40rpx;
}

.empty-icon {
  font-size: 100rpx;
  margin-bottom: 30rpx;
}

.empty-text {
  color: #999999;
  font-size: 30rpx;
  margin-bottom: 30rpx;
}

.empty-btn {
  padding: 16rpx 48rpx;
  background-color: #8B4513;
  border-radius: 40rpx;
}

.empty-btn text {
  color: #ffffff;
  font-size: 28rpx;
}
